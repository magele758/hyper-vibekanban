{
  "name": "hyper-vibekanban",
  "private": false,
  "version": "0.1.47",
  "main": "index.js",
  "bin": {
    "hyper-vibekanban": "bin/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bin/cli.js --external:adm-zip --banner:js=\"#!/usr/bin/env node\"",
    "check": "tsc --noEmit -p tsconfig.json",
    "inject:release": "node scripts/inject-release-config.js",
    "test": "node --test scripts/*.test.js"
  },
  "keywords": [],
  "author": "magele758",
  "homepage": "https://github.com/magele758/hyper-vibekanban",
  "bugs": {
    "url": "https://github.com/magele758/hyper-vibekanban/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magele758/hyper-vibekanban.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "",
  "description": "npx launcher for the hyper-vibekanban server, MCP, and review CLI",
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cac": "^7.0.0"
  },
  "files": [
    "bin",
    "dist"
  ]
